/**
 * Golden test: the TypeScript MC7 decoder must reproduce the Python reference
 * decoder's stream exactly. The committed fixtures are a SYNTHETIC corpus
 * hand-assembled from docs/MC7.md covering every decoded construct (all bit-op
 * forms and areas, L/T forms, constants, S5T, jumps, the CALL FC descriptor
 * frame, the FB+instance-DB frame, and an undecodable RAW case). The expected
 * stream was generated by the Python reference decoder, itself validated
 * byte-exact against 6 SIMATIC-compiled ground-truth blocks (7417 statements,
 * 29652 bytes, 84 jumps — see docs/MC7.md). No user program data is committed.
 *
 * Full-project regression (local only, never committed):
 *   MC7FULL=/path/to/dir tsx tests/mc7_golden.mts
 * expects golden_stream.json + golden_code.json + project_snapshot.json in that dir.
 */
import { readFileSync } from 'node:fs';
import { S7Project, ProjectSnapshot } from '../src/mc7/project';
import { streamBlock, StreamEntry } from '../src/mc7/stream';

const full = process.env.MC7FULL;
const read = (n: string) => JSON.parse(readFileSync(full ? `${full}/${n}` : new URL('./fixtures/' + n, import.meta.url), 'utf8'));
const gold: Record<string, { len: number; seq: any[] }> = read(full ? 'golden_stream.json' : 'golden_stream.json');
const snap: ProjectSnapshot = read(full ? 'project_snapshot.json' : 'snapshot.json');
const codeMap: Record<string, string> | null = full ? read('golden_code.json') : null;
const proj = new S7Project(snap);

function hex2u8(h: string): Uint8Array {
  const u = new Uint8Array(h.length / 2);
  for (let i = 0; i < u.length; i++) u[i] = parseInt(h.substr(i * 2, 2), 16);
  return u;
}

function norm(e: StreamEntry): any {
  if (e.kind === 'I') return { kind: 'I', off: e.off, op: e.op, arg: e.arg ?? null };
  if (e.kind === 'RAW') return { kind: 'RAW', off: e.off, hex: e.hex };
  if (e.kind === 'CALL') {
    return { kind: 'CALL', off: e.off, target: e.target, scratch: e.scratch, blds: e.blds, pre: e.pre, hdrw: e.hdrw, params: e.params, post: e.post };
  }
  return { kind: 'CALLFB', off: e.off, fb: e.fb, inst: e.inst, scratch: e.scratch, tar2: e.tar2, blds: e.blds, pre: e.pre, post: e.post };
}

const canon = (x: any): string => JSON.stringify(x, (k, v) => {
  if (v && typeof v === 'object' && !Array.isArray(v)) return Object.fromEntries(Object.entries(v).sort(([a], [b]) => (a < b ? -1 : 1)));
  return v;
});

let fail = 0;
for (const fc of Object.keys(gold)) {
  const hex = codeMap ? codeMap[fc] : snap.blocks[fc]?.code ?? snap.blocks['FC' + fc]?.code;
  if (!hex) { console.log(`FC${fc}: no code`); fail++; continue; }
  const code = hex2u8(hex);
  if (code.length !== gold[fc].len) { console.log(`FC${fc}: code length ${code.length} != ${gold[fc].len}`); fail++; continue; }
  const seq = streamBlock(code, proj).map(norm);
  const g = gold[fc].seq;
  let diffs = 0;
  const n = Math.min(seq.length, g.length);
  for (let i = 0; i < n; i++) {
    const a = canon(seq[i]), b = canon(g[i]);
    if (a !== b) {
      if (diffs < 3) console.log(`FC${fc} [${i}] @${g[i].off}:\n  ts  ${a.slice(0, 200)}\n  py  ${b.slice(0, 200)}`);
      diffs++;
    }
  }
  if (seq.length !== g.length) { console.log(`FC${fc}: entry count ${seq.length} != golden ${g.length}`); diffs++; }
  const raws = seq.filter((e: any) => e.kind === 'RAW').length;
  const expectRaw = g.filter((e: any) => e.kind === 'RAW').length;
  console.log(`FC${fc}: ${seq.length} entries, ${diffs} diffs, RAW=${raws}${!diffs && raws === expectRaw ? ' OK' : ''}`);
  if (diffs || raws !== expectRaw) fail++;
}
console.log(fail ? `FAIL (${fail})` : 'ALL GOLDEN TESTS PASS' + (full ? ' (full project)' : ' (synthetic corpus)'));
process.exit(fail ? 1 : 0);
